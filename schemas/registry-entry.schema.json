{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/igorgsduarte/pitcrew-plugins/main/schemas/registry-entry.schema.json",
  "title": "PitCrew registry entry (registry/<id>.json)",
  "description": "One published plugin and its releases, newest first. See docs/registry.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "repo", "releases"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "path": { "type": "string", "description": "The plugin's folder inside repo, when the repo holds more than one plugin." },
    "tier": { "enum": ["official", "community", "content"], "description": "Set by the reviewer, never by the author." },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "tag", "asset", "sha256", "bytes", "api"],
        "properties": {
          "version": { "type": "string", "pattern": "^[0-9]{1,6}\\.[0-9]{1,6}\\.[0-9]{1,6}$" },
          "tag": { "type": "string", "minLength": 1 },
          "asset": { "type": "string", "pattern": "\\.zip$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "api": { "const": "pitcrew:plugin@1" }
        }
      }
    }
  }
}
