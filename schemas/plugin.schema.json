{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/igorgsduarte/pitcrew-plugins/main/schemas/plugin.schema.json",
  "title": "PitCrew plugin.json",
  "description": "The manifest of a PitCrew plugin or content package. See docs/manifest.md. pcplugin validate also checks the rules that a schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "publisher", "kind"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "version": { "type": "string", "pattern": "^[0-9]{1,6}\\.[0-9]{1,6}\\.[0-9]{1,6}$" },
    "publisher": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "maxLength": 300 },
    "license": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/?$" },
    "kind": { "enum": ["plugin", "content"] },
    "api": { "const": "pitcrew:plugin@1" },
    "entry": { "type": "string", "pattern": "^[^/\\\\]+\\.wasm$" },
    "extends": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["topic:flag", "topic:session", "devices:serial", "content:write-own"] }
    },
    "tickHz": { "type": "integer", "minimum": 1, "maximum": 60 },
    "settings": { "type": "array", "items": { "$ref": "#/$defs/setting" } },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1, "maxLength": 24 }
        }
      }
    },
    "nav": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "icon"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 16 },
        "icon": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "A lucide icon name." }
      }
    },
    "provides": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" } },
    "packs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "plugin" } } },
      "then": { "required": ["api", "entry"], "not": { "required": ["extends"] } }
    },
    {
      "if": { "properties": { "kind": { "const": "content" } } },
      "then": {
        "required": ["extends", "packs"],
        "properties": { "entry": false, "api": false, "permissions": false, "tickHz": false, "nav": false }
      }
    }
  ],
  "$defs": {
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "label"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,31}$" },
        "type": { "enum": ["serialPort", "integer", "number", "boolean", "string", "select", "contentRef"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "default": {},
        "min": { "type": "number" },
        "max": { "type": "number" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": { "value": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 } }
          }
        },
        "of": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" }
      }
    }
  }
}
