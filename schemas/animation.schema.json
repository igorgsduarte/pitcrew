{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/igorgsduarte/pitcrew-plugins/main/schemas/animation.schema.json",
  "title": "Flags animation (flags.animations)",
  "description": "One 8x8 animation. Each frame is 8 rows of 8 palette characters, top row first. See docs/content-packs.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "palette", "fps", "loop", "frames"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "palette": {
      "type": "object",
      "required": ["."],
      "maxProperties": 16,
      "propertyNames": { "minLength": 1, "maxLength": 1 },
      "additionalProperties": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" }
    },
    "fps": { "type": "integer", "minimum": 1, "maximum": 30 },
    "loop": { "type": "boolean" },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 120,
      "items": {
        "type": "array",
        "minItems": 8,
        "maxItems": 8,
        "items": { "type": "string", "minLength": 8, "maxLength": 8 }
      }
    }
  }
}
